{
  "name": "rbbt-client",
  "version": "0.5.5",
  "main": "./dist/index.ts",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "import": "./dist/next/index.mjs",
      "require": "./dist/next/index.js"
    }
  },
  "scripts": {
    "build": "tsup"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adriantobi/rbbt-client.git"
  },
  "keywords": [
    "rabbitmq",
    "stomp",
    "rxjs",
    "broker"
  ],
  "author": "Adrian Tobi",
  "license": "ISC",
  "description": "RabbitMQ Broker Client",
  "peerDependencies": {
    "react": ">=16.8.0",
    "next": ">=13.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@stomp/rx-stomp": "^2.0.0"
  }
}
